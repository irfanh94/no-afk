# --- Rust -------------------------------------------------------------------
# Matches at any depth: the workspace shares one root target/, but a crate built
# standalone makes its own.
target/

# --- Tauri ------------------------------------------------------------------
# Regenerated by tauri-build on every build. Scoped to schemas/ rather than all of
# gen/ deliberately: if mobile targets are ever added, gen/apple and gen/android are
# real source and must be committed.
/src-tauri/gen/schemas/

# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
# NB: package-lock.json is intentionally NOT ignored — it should be committed.

# --- Generated icons --------------------------------------------------------
# Intermediate only. The PNGs and icon.icns beside it ARE committed, because
# tauri.conf.json references them at build time and a fresh clone must build
# without running tools/gen_icons.py first.
/src-tauri/icons/icon.iconset/

# --- Python (tools/) --------------------------------------------------------
__pycache__/
*.py[cod]

# --- Secrets & signing ------------------------------------------------------
# This repo is public and Phase 3 introduces code signing, notarization and the
# Tauri updater's private key. Ignoring these up front is cheaper than a leak.
.env
.env.*
!.env.example
*.p12
*.pem
*.cer
*.certSigningRequest
*.provisionprofile
*.mobileprovision
# Tauri updater signing key (the .pub counterpart is safe to commit)
*.key
!*.pub

# --- Local working notes ----------------------------------------------------
# Private planning doc. Kept out of the repo because it records the dev machine's
# managed-device configuration, which is not ours to publish.
/PLAN.md

# --- Editors & OS -----------------------------------------------------------
.idea/
.vscode/
.DS_Store
._*

# --- Claude Code ------------------------------------------------------------
# Per-developer permission state. Scoped to this one file rather than .claude/, so
# shared project config (settings.json, commands/, agents/, skills/) stays committable.
.claude/settings.local.json
