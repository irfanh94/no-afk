{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "no-afk",
  "version": "0.1.0",
  "identifier": "dev.irfanhodzic.no-afk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Keep your Mac awake.",
    "longDescription": "A menu bar utility that stops macOS sleeping, blanking the display, or locking the screen. Uses IOKit power assertions; no permissions required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMTExMDFGRkJFMzVBQTkKUldTcFd1UDdIeEFSeTcwUjN6M0tKK01KOEZCQmlzL01JTi8vaS85RWNwaERTS1JNbElQVno1RzQK",
      "endpoints": [
        "https://github.com/irfanh94/no-afk/releases/latest/download/latest.json"
      ]
    }
  }
}
